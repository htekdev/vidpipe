# === Required ===
# OpenAI API key for Whisper transcription and AI agents
OPENAI_API_KEY=sk-your-openai-api-key-here

# === Optional ===
# Folder to watch for new video recordings (default: ./watch)
# WATCH_FOLDER=./watch                          # Unix/Mac
# WATCH_FOLDER=C:\Videos\Recordings             # Windows example

# Root directory of the repository (default: current working directory)
# REPO_ROOT=.

# Output directory for processed recordings (default: ./recordings)
# OUTPUT_DIR=./recordings

# FFmpeg/FFprobe paths (default: auto-detected via ffmpeg-static, then system PATH)
# Only set these if you need a specific FFmpeg build
# FFMPEG_PATH=/usr/local/bin/ffmpeg              # Unix/Mac
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe     # Windows
# FFPROBE_PATH=/usr/local/bin/ffprobe            # Unix/Mac
# FFPROBE_PATH=C:\tools\ffmpeg\bin\ffprobe.exe   # Windows

# Exa AI API key for web search in social media posts (optional)
# EXA_API_KEY=your-exa-api-key-here

# LLM Provider Configuration
# Options: copilot (default), openai, claude
LLM_PROVIDER=copilot
# Override the default model for the selected provider (optional)
# LLM_MODEL=claude-opus-4.6
# Required if LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# Late API — social media publishing (optional)
# Sign up at https://getlate.dev, connect your social accounts, then add your API key
# LATE_API_KEY=sk_your_key_here
# LATE_PROFILE_ID=your_profile_id_here

# Cloud storage backend (default: azure). AWS mode does not require Azure keys.
# See docs/aws-storage.md for provisioning, authentication and migration.
# STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_CONTAINER_NAME=vidpipe

# AWS resource settings (required by the AWS backend except optional prefix).
# Credentials use the AWS SDK default chain: SSO, profiles, environment or roles.
# Do not store AWS access keys in VidPipe global configuration.
# STORAGE_PROVIDER=aws
# AWS_REGION=us-west-2
# AWS_S3_BUCKET=
# AWS_S3_PREFIX=
# AWS_DYNAMODB_CONTENT_TABLE=
# AWS_DYNAMODB_VIDEOS_TABLE=
# AWS_PROFILE=vidpipe
